<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/bloom_splash_base</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/bloom_splash_blank_icon</item>
        <item name="android:statusBarColor">@color/bloom_splash_status</item>
        <item name="android:navigationBarColor">@color/bloom_splash_base</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">@drawable/bloom_splash_background</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/bloom_splash_background</item>
        <item name="android:statusBarColor">@color/bloom_splash_status</item>
        <item name="android:navigationBarColor">@color/bloom_splash_base</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
