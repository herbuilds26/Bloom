rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    match /users/{uid} {
      allow read, create: if owner(uid);
      allow update: if owner(uid) && request.resource.data.uid == uid;
      allow delete: if owner(uid);
      match /{collection}/{document} {
        allow read, create, update, delete: if owner(uid);
      }
    }
    match /{document=**} { allow read, write: if false; }
  }
}
